  },
  "dependencies": {
    "@copilotkit/bot": "workspace:*",
    "@copilotkit/bot-teams": "workspace:*",
    "@copilotkit/bot-ui": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/m365agentsplayground": "^0.2.27",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

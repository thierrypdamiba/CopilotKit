{
  "name": "teams-example",
  "version": "0.0.1",
  "private": true,
  "description": "Runnable demo for @copilotkit/bot-teams — an echo bot you can test in the Microsoft 365 Agents Playground with no Microsoft credentials.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch app/index.ts",
    "start": "tsx app/index.ts",
